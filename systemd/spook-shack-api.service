[Unit]
Description=Spook Shack API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@SPOOK_SHACK_ROOT@
EnvironmentFile=-@SPOOK_SHACK_ROOT@/.env
Environment=SPOOK_SHACK_HOME=@SPOOK_SHACK_ROOT@/.spook-shack
ExecStart=@SPOOK_SHACK_ROOT@/.venv/bin/spook-shack serve --host 127.0.0.1 --port 8000 --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
